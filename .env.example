# ============================================================================
# oxbot — Environment Variables
# ============================================================================
# Copy this file to `.env` and fill in what you need.
#
#   cp .env.example .env
#
# oxbot runs in DEV MOCK MODE for any integration whose keys are missing:
#   - CAPTCHA          -> auto-passes
#   - Email magic link -> printed to the server console (no SMTP needed)
#   - X (Twitter)      -> follow/like/retweet checks auto-pass; mock connect
#   - Discord          -> membership/role checks auto-pass; mock connect
#   - Uploads          -> saved to /public/uploads on local disk
#
# This lets you run the entire app end-to-end with ONLY a DATABASE_URL set.
# Provide real keys below to switch any integration to live mode automatically.
# ============================================================================


# --- Core (required) -------------------------------------------------------

# PostgreSQL connection string (Neon, Supabase, Railway, local, etc.)
# Example (Neon): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/oxbot?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/oxbot?schema=public"

# Auth.js / NextAuth secret. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# The canonical URL of the app (used for OAuth callbacks + magic links).
# In local dev this is http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
# Auth.js v5 also reads AUTH_URL; keep them in sync.
AUTH_URL="http://localhost:3000"


# --- Email magic link (optional; omit for console-link dev mode) -----------
# SMTP transport for magic-link sign-in + notifications.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="oxbot <no-reply@oxbot.app>"


# --- X (Twitter) OAuth 2.0 (optional) --------------------------------------
# Create an app at https://developer.x.com — enable OAuth 2.0, add callback:
#   http://localhost:3000/api/auth/callback/twitter
# "Read" scope is enough for follow/like/retweet verification.
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""
# App-only bearer token used for server-side follow/like/retweet checks.
TWITTER_BEARER_TOKEN=""


# --- Discord OAuth2 + bot (optional) ---------------------------------------
# Create an app at https://discord.com/developers/applications
# OAuth2 redirect: http://localhost:3000/api/auth/callback/discord
# Scopes: identify, guilds, guilds.members.read
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
# Bot token (same application) used to verify server membership + roles.
# The bot must be a member of any guild you gate giveaways on.
DISCORD_BOT_TOKEN=""


# --- CAPTCHA (optional) ----------------------------------------------------
# Choose ONE provider. If neither is set, CAPTCHA auto-passes in dev.
# provider: "recaptcha" | "hcaptcha"
CAPTCHA_PROVIDER=""
# Google reCAPTCHA v3
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
# hCaptcha
HCAPTCHA_SITE_KEY=""
HCAPTCHA_SECRET_KEY=""
# Public site key exposed to the browser (set to whichever provider you use).
NEXT_PUBLIC_CAPTCHA_SITE_KEY=""
NEXT_PUBLIC_CAPTCHA_PROVIDER=""


# --- Uploads (optional; omit for local /public/uploads dev mode) -----------
# S3-compatible storage (AWS S3, Cloudflare R2, Supabase Storage, MinIO...).
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL that serves objects from the bucket.
S3_PUBLIC_URL=""


# --- Misc ------------------------------------------------------------------
# Set to "1" to force mock mode for ALL integrations even if keys are present
# (handy for local testing / CI). Leave empty for automatic detection.
OXBOT_FORCE_MOCKS=""
